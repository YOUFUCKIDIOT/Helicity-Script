local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Configuration
_G.AutoHop = false
_G.TargetRisk = "High"

local RiskHierarchy = {
    ["Find Storm"] = 1,
    ["Marginal"] = 2,
    ["Mild"] = 3,
    ["Enhanced"] = 4,
    ["Moderate"] = 5,
    ["High"] = 6
}

local Window = Rayfield:CreateWindow({
   Name = "Helicity | Risk Hunter",
   LoadingTitle = "Scanning Atmosphere...",
   LoadingSubtitle = "by Pleq",
   ConfigurationSaving = {Enabled = true, FolderName = "HelicityWeather"}
})

local MainTab = Window:CreateTab("Auto-Finder", 4483362458)

-- Function to find the current risk level from the game UI
local function GetCurrentRisk()
    local risk = "Unknown"
    -- Attempt to find the risk text in the Helicity UI (Typical paths for this game)
    pcall(function()
        -- This looks for the text inside the NWS/Outlook UI
        local gui = game:GetService("Players").LocalPlayer.PlayerGui
        local outlook = gui:FindFirstChild("MainUI", true) or gui:FindFirstChild("HUD", true)
        
        -- Helicity usually stores risk in a label. We scan for the keywords.
        for _, v in pairs(outlook:GetDescendants()) do
            if v:IsA("TextLabel") or v:IsA("TextBox") then
                for riskName, _ in pairs(RiskHierarchy) do
                    if string.find(v.Text, riskName) then
                        risk = riskName
                    end
                end
            end
        end
    end)
    return risk
end

local StatusLabel = MainTab:CreateLabel("Current Server Risk: Checking...")

MainTab:CreateDropdown({
   Name = "Target Risk Level",
   Options = {"Find Storm", "Marginal", "Mild", "Enhanced", "Moderate", "High"},
   CurrentOption = {"High"},
   MultipleOptions = false,
   Callback = function(Option)
      _G.TargetRisk = Option[1]
   end,
})

MainTab:CreateToggle({
   Name = "Auto-Hop for Risk",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoHop = Value
   end,
})

-- The "Brain" of the script
task.spawn(function()
    while task.wait(3) do
        local current = GetCurrentRisk()
        StatusLabel:Set("Current Server Risk: " .. current)
        
        if _G.AutoHop then
            local currentVal = RiskHierarchy[current] or 0
            local targetVal = RiskHierarchy[_G.TargetRisk] or 6
            
            -- If current risk is lower than what you want, Hop!
            if currentVal < targetVal then
                Rayfield:Notify({
                   Title = "Risk Too Low",
                   Content = "Found " .. current .. ", looking for " .. _G.TargetRisk .. ". Hopping...",
                   Duration = 3
                })
                
                local HttpService = game:GetService("HttpService")
                local TeleportService = game:GetService("TeleportService")
                local Servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"))
                
                for _, s in pairs(Servers.data) do
                    if s.playing < s.maxPlayers and s.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id)
                        break
                    end
                end
            else
                Rayfield:Notify({
                   Title = "Target Found!",
                   Content = "This server meets your " .. _G.TargetRisk .. " requirement!",
                   Duration = 10
                })
                _G.AutoHop = false -- Stop hopping once found
            end
        end
    end
end)
