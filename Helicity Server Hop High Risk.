local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Risk Hierarchy Setup
local RiskHierarchy = {
    ["Find Storm"] = 1,
    ["Marginal"] = 2,
    ["Mild"] = 3,
    ["Enhanced"] = 4,
    ["Moderate"] = 5,
    ["High"] = 6
}

local Window = Rayfield:CreateWindow({
   Name = "Helicity | Auto-Hunter",
   LoadingTitle = "Atmospheric Re-Entry...",
   LoadingSubtitle = "by Pleq",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "HelicityHunter",
      FileName = "AutoConfig"
   }
})

local MainTab = Window:CreateTab("Auto-Finder", 4483362458)
local StatusLabel = MainTab:CreateLabel("Current Server Risk: Checking...")

-- Values to be saved
_G.TargetRisk = "High"
_G.AutoHopEnabled = false

MainTab:CreateDropdown({
   Name = "Target Risk Level",
   Options = {"Find Storm", "Marginal", "Mild", "Enhanced", "Moderate", "High"},
   CurrentOption = {"High"},
   Flag = "TargetRisk", -- Used for config saving
   Callback = function(Option)
      _G.TargetRisk = Option[1]
   end,
})

MainTab:CreateToggle({
   Name = "Enable Auto-Search",
   CurrentValue = false,
   Flag = "AutoHopToggle", -- Used for config saving
   Callback = function(Value)
      _G.AutoHopEnabled = Value
   end,
})

-- Logic to read the game's risk UI
local function GetCurrentRisk()
    local risk = "Unknown"
    pcall(function()
        local gui = game:GetService("Players").LocalPlayer.PlayerGui
        local hud = gui:FindFirstChild("MainUI", true) or gui:FindFirstChild("HUD", true)
        
        for _, v in pairs(hud:GetDescendants()) do
            if v:IsA("TextLabel") then
                for riskName, _ in pairs(RiskHierarchy) do
                    if string.find(v.Text, riskName) then
                        risk = riskName
                    end
                end
            end
        end
    end)
    return risk
end

-- The Loop
task.spawn(function()
    -- Wait for game to load fully
    if not game:IsLoaded() then game.Loaded:Wait() end
    task.wait(5) -- Give the weather UI time to appear
    
    while true do
        local current = GetCurrentRisk()
        StatusLabel:Set("Current Server Risk: " .. current)
        
        if _G.AutoHopEnabled then
            local currentVal = RiskHierarchy[current] or 0
            local targetVal = RiskHierarchy[_G.TargetRisk] or 6
            
            if currentVal < targetVal then
                Rayfield:Notify({Title = "Scanning...", Content = "Risk too low ("..current.."). Hopping!", Duration = 3})
                
                -- Server Hop Logic
                local HttpService = game:GetService("HttpService")
                local TeleportService = game:GetService("TeleportService")
                local Servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"))
                
                for _, s in pairs(Servers.data) do
                    if s.playing < s.maxPlayers and s.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id)
                        break
                    end
                end
                break -- Exit loop to prevent multiple teleports
            else
                StatusLabel:Set("✅ TARGET FOUND: " .. current)
            end
        end
        task.wait(5)
    end
end)

-- LOAD CONFIGURATION (This is the "Auto" part)
Rayfield:LoadConfiguration()
