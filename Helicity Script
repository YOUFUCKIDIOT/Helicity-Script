--  EF / WIND READING  (broad, deep scan - cached)
-- ════════════════════════════════════════════════════════════
local function deepReadNum(model,...)
    if not model then return nil end
    local keys={...}
    -- Attributes first (fastest)
    local ok,attrs=pcall(function() return model:GetAttributes() end)
    if ok then
        for k,v in pairs(attrs) do
            local lk=k:lower()
            for _,key in ipairs(keys) do
                if type(v)=="number" and (lk==key:lower() or lk:find(key:lower(),1,true)) then
                    return v
                end
            end
        end
    end
    -- Direct children
    for _,child in ipairs(model:GetChildren()) do
        if child:IsA("ValueBase") then
            local ln=child.Name:lower()
            for _,key in ipairs(keys) do
                if ln==key:lower() or ln:find(key:lower(),1,true) then
                    local n=tonumber(child.Value); if n then return n end
                end
            end
        end
    end
    -- All descendants
    for _,v in ipairs(model:GetDescendants()) do
        if v:IsA("ValueBase") then
            local ln=v.Name:lower()
            for _,key in ipairs(keys) do
                if ln==key:lower() or ln:find(key:lower(),1,true) then
                    local n=tonumber(v.Value); if n then return n end
                end
            end
        end
    end
    return nil
end

local function readGlobalStormParam(...)
    local keys={...}
    local roots={Workspace,
        Workspace:FindFirstChild("Storm"), Workspace:FindFirstChild("Weather"),
        Workspace:FindFirstChild("Environment"), Workspace:FindFirstChild("Meteorology"),
        Workspace:FindFirstChild("Tornadoes"), Workspace:FindFirstChild("StormData")}
    for _,root in ipairs(roots) do
        if root then
            for _,obj in ipairs(root:GetDescendants()) do
                if obj:IsA("ValueBase") then
                    local ln=obj.Name:lower()
                    for _,key in ipairs(keys) do
                        if ln==key:lower() or ln:find(key:lower(),1,true) then
                            local n=tonumber(obj.Value); if n then return n end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function windToEF(mph)
    if not mph then return "?" end
    if mph>=200 then return "5" elseif mph>=166 then return "4"
    elseif mph>=136 then return "3" elseif mph>=111 then return "2"
    elseif mph>=86 then return "1" else return "0" end
end

local function toCompass(deg)
    local d={"N","NE","E","SE","S","SW","W","NW"}
    return d[math.floor(((deg%360)/45)+0.5)%8+1]
end

