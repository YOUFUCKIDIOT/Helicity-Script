-- Scan the actual game for SpawnLocation and town markers — uses REAL names from Helicity
local townData = {}  -- {name, pos}
local townDD   = nil

local SPAWN_KEYWORDS = {"spawn","town","city","village","hub","base","shelter","station","field","garage","depot"}

local function scanTowns()
    townData = {}
    local seen = {}

    -- Method 1: SpawnLocation objects (most reliable — game places them at each town)
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and not seen[obj] then
            seen[obj] = true
            local pos = obj.Position + Vector3.new(0, 5, 0)
            local name = obj.Name
            -- Clean up name (remove "SpawnLocation", "Spawn_", etc.)
            name = name:gsub("SpawnLocation",""):gsub("Spawn_",""):gsub("_"," "):gsub("%-"," "):match("^%s*(.-)%s*$")
            if name == "" then name = "Spawn" end
            table.insert(townData, {name=name, pos=pos})
        end
    end

    -- Method 2: Model/Part named after towns if no SpawnLocations found
    if #townData == 0 then
        for _,obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Folder")) and not seen[obj] then
                local ln = obj.Name:lower()
                for _,kw in ipairs(SPAWN_KEYWORDS) do
                    if ln:find(kw,1,true) and #obj.Name < 40 then
                        seen[obj] = true
                        local pos
                        if obj:IsA("BasePart") then
                            pos = obj.Position + Vector3.new(0,5,0)
                        elseif obj:IsA("Model") then
                            local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if p then pos = p.Position + Vector3.new(0,5,0) end
                        end
                        if pos then
                            table.insert(townData, {name=obj.Name, pos=pos})
                        end
                        break
                    end
                end
            end
        end
    end

    -- Build maps
    local names = {}
    if #townData == 0 then
