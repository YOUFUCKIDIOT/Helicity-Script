-- Deep-search a tornado model for a named value
local function findVal(model, ...)
    if not model then return nil end
    local keys = {...}
    for _, v in ipairs(model:GetDescendants()) do
        local ln = v.Name:lower()
        for _, k in ipairs(keys) do
            if ln:find(k:lower()) and v:IsA("ValueBase") then
                return v
            end
        end
    end
    return nil
end

-- Read numeric value safely
local function readNum(model, ...)
    local v = findVal(model, ...)
    return v and tonumber(v.Value) or nil
end

-- Infer EF rating from wind speed
local function windToEF(mph)
    if not mph then return "?" end
    if mph >= 200 then return "5"
    elseif mph >= 166 then return "4"
    elseif mph >= 136 then return "3"
    elseif mph >= 111 then return "2"
    elseif mph >= 86  then return "1"
    else return "0" end
end

-- Get tornado root part
local function getTornadoRoot(t)
    if not t then return nil end
    return t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
end

-- Collect all tornado models in workspace
local function getTornadoes()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local n = obj.Name:lower()
        if obj:IsA("Model") and (
            n:find("tornado") or n:find("vortex") or n:find("funnel") or
            n:find("wedge")   or n:find("cyclone") or n:find("twister") or
            (n:find("ef") and not n:find("effect"))
        ) then
            -- avoid duplicates (child model inside parent tornado)
            local skip = false
            for _, f in ipairs(found) do
                if obj:IsDescendantOf(f) then skip = true; break end
            end
            if not skip then table.insert(found, obj) end
        end
    end
    return found
end

local function buildTornadoNames()
    tornadoList = getTornadoes()
    local names = {"-- None --"}
    for i, t in ipairs(tornadoList) do
        names[i + 1] = t.Name .. " [" .. i .. "]"
    end
    return names
end

local function getServerList()
    local ok, result = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?limit=100")
        )
    end)
    if ok and result and result.data then return result.data end
    return nil
end

-- Average velocity from ring buffer
local function avgVelocity()
    if #velHistory == 0 then return Vector3.zero end
    local sum = Vector3.zero
    for _, v in ipairs(velHistory) do sum += v end
    return sum / #velHistory
end

