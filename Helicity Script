local function getTornadoes()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local n = obj.Name:lower()
            if n:find("tornado") or n:find("vortex") or n:find("funnel") or
               n:find("wedge")   or n:find("cyclone") or n:find("twister") or
               (n:find("ef") and not n:find("effect")) then
                local skip = false
                for _, f in ipairs(found) do
                    if obj:IsDescendantOf(f) then skip = true; break end
                end
                if not skip then table.insert(found, obj) end
            end
        end
    end
    return found
end

local function getTornadoRoot(t)
    if not t then return nil end
    return t.PrimaryPart or t:FindFirstChildWhichIsA("BasePart")
end

local function buildTornadoNames()
    tornadoList = getTornadoes()
    local names = {"-- None --"}
    for i, t in ipairs(tornadoList) do
        names[i+1] = t.Name.." ["..i.."]"
    end
    return names
end

-- ════════════════════════════════════════════════════════════
--  EF / WIND READING  (fixed — very broad search)
-- ════════════════════════════════════════════════════════════
-- Reads a number value from: model attributes, direct children, all descendants,
-- and also searches global Workspace folders (storm data is sometimes stored globally)
local function deepReadNum(model, ...)
    if not model then return nil end
    local keys = {...}

    -- 1. Check model's own Attributes
    for _, k in ipairs(keys) do
        local v = pcall(function() return model:GetAttribute(k) end) and model:GetAttribute(k)
        if type(v) == "number" then return v end
        -- case-insensitive attribute scan
        local ok2, attrs = pcall(function() return model:GetAttributes() end)
        if ok2 then
            for attrName, attrVal in pairs(attrs) do
                if attrName:lower():find(k:lower()) and type(attrVal) == "number" then
                    return attrVal
                end
            end
        end
    end

    -- 2. Direct children first (faster + avoids false positives deep in mesh)
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("ValueBase") then
            local ln = child.Name:lower()
            for _, k in ipairs(keys) do
                if ln == k:lower() or ln:find(k:lower()) then
                    local n = tonumber(child.Value)
                    if n then return n end
                end
            end
        end
    end

    -- 3. All descendants
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("ValueBase") then
            local ln = v.Name:lower()
            for _, k in ipairs(keys) do
                if ln == k:lower() or ln:find(k:lower()) then
                    local n = tonumber(v.Value)
                    if n then return n end
                end
            end
        end
    end

    return nil
end

-- Also scan global workspace for storm parameter folders
local function readGlobalStormParam(...)
    local keys = {...}
    local searchRoots = {Workspace, Workspace:FindFirstChild("Storm"), Workspace:FindFirstChild("Weather"),
                         Workspace:FindFirstChild("Environment"), Workspace:FindFirstChild("Atmosphere"),
                         Workspace:FindFirstChild("Meteorology")}
    for _, root in ipairs(searchRoots) do
        if root then
            for _, obj in ipairs(root:GetDescendants()) do
                if obj:IsA("ValueBase") then
                    local ln = obj.Name:lower()
                    for _, k in ipairs(keys) do
                        if ln == k:lower() or ln:find(k:lower()) then
                            local n = tonumber(obj.Value)
                            if n then return n end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function windToEF(mph)
    if not mph then return "?" end
    if mph >= 200 then return "5"
    elseif mph >= 166 then return "4"
    elseif mph >= 136 then return "3"
    elseif mph >= 111 then return "2"
    elseif mph >= 86  then return "1"
    else return "0" end
end

local function toCompass(deg)
    local dirs = {"N","NE","E","SE","S","SW","W","NW"}
    return dirs[math.floor(((deg % 360)/45) + 0.5) % 8 + 1]
end

