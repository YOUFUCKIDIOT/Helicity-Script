-- Find all remotes in ReplicatedStorage + children (done once on demand)
local _remoteCache = nil
local function getAllRemotes()
    if _remoteCache then return _remoteCache end
    _remoteCache = {}
    local function scan(obj)
        for _,v in ipairs(obj:GetChildren()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") or v:IsA("BindableEvent") then
                table.insert(_remoteCache, v)
            end
            pcall(scan, v)
        end
    end
    scan(ReplicatedStorage)
    -- Also check Workspace scripts sometimes store remotes here
    scan(Workspace)
    return _remoteCache
end

-- Fire a remote safely, trying multiple argument formats
local function fireRemote(remote, vehicleName)
    local argSets = {
        {vehicleName},
        {vehicleName, true},
        {{name=vehicleName}},
        {{vehicle=vehicleName}},
        {{VehicleName=vehicleName}},
        {{car=vehicleName}},
        {{Name=vehicleName}},
        {{model=vehicleName}},
    }
    for _,args in ipairs(argSets) do
        pcall(function()
            if remote:IsA("RemoteFunction") then
                remote:InvokeServer(table.unpack(args))
            elseif remote:IsA("RemoteEvent") then
                remote:FireServer(table.unpack(args))
            elseif remote:IsA("BindableEvent") then
                remote:Fire(table.unpack(args))
            end
        end)
    end
end

-- Keywords that suggest vehicle spawning/buying remotes
local VEH_KEYWORDS = {"spawn","vehicle","car","give","buy","purchase","unlock","shop","garage","deal"}

local function spawnVehicle(vehicleName)
    local remotes = getAllRemotes()
    local fired = 0
    for _,remote in ipairs(remotes) do
        local ln = remote.Name:lower()
        for _,kw in ipairs(VEH_KEYWORDS) do
            if ln:find(kw) then
                fireRemote(remote, vehicleName)
                fired += 1
                break
            end
        end
    end
    return fired
end

