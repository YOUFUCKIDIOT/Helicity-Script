-- ⭐ FIND BEST SERVER
-- "Best" = highest risk storm environment:
-- highest CAPE, wind shear, dew point, lapse rate, RH → most tornado-prone server
-- Since we can't read other servers' atmo data remotely, we use player count as the
-- best available proxy (more players chasing = active tornado outbreak happening)
-- Picks the most populated server that isn't full, labelled HIGH RISK
ServerTab:CreateButton({
    Name="⭐ Find Best Server (High Risk)",
    Callback=function()
        notify("Best Server","Scanning for highest-risk storm server...")
        task.spawn(function()
            local data=getServerList()
            if not data then notify("Error","Could not fetch servers."); return end

            -- Score each server:
            -- High player count = active outbreak (players chase = tornadoes exist)
            -- Not completely full = we can join
            -- Not current server
            local best, bestScore = nil, -1
            for _, s in ipairs(data) do
                if s.id ~= game.JobId and s.playing and s.maxPlayers then
                    local fillRatio = s.playing / s.maxPlayers
                    -- Best = high fill (active) but not 100% full (can join)
                    -- Peak sweet spot ~70-90% fill
                    local score = 0
                    if fillRatio < 1.0 then
                        -- Prefer servers that are 50-90% full (busy but joinable)
                        if fillRatio >= 0.5 then
                            score = s.playing * 2  -- reward busy servers heavily
                        else
                            score = s.playing      -- lighter reward for quieter servers
                        end
                    end
                    if score > bestScore then
                        best=s; bestScore=score
                    end
                end
            end

            if best then
                local fill=math.floor((best.playing/best.maxPlayers)*100)
                notify("⭐ Best Server Found!",
                    "Players: "..best.playing.."/"..best.maxPlayers.." ("..fill.."% full)\n"..
                    "High activity = best storm risk. Joining...", 6)
                task.wait(2)
                TeleportService:TeleportToPlaceInstance(game.PlaceId,best.id,player)
            else
                notify("Best Server","No suitable server found. Try again.")
            end
        end)
    end,
})

