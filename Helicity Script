-- Track segment line (neon beam between current + predicted)
local function updatePredLine(fromPos, toPos)
    local existing = Workspace:FindFirstChild("_PredBeam")
    if existing then existing:Destroy() end

    local mid   = (fromPos + toPos) / 2
    local dist  = (toPos - fromPos).Magnitude
    if dist < 1 then return end
    local dir   = (toPos - fromPos).Unit

    local beam = Instance.new("Part")
    beam.Name        = "_PredBeam"
    beam.Anchored    = true
    beam.CanCollide  = false
    beam.Material    = Enum.Material.Neon
    beam.Color       = Color3.fromRGB(255, 80, 0)
    beam.Transparency = 0.45
    beam.Size        = Vector3.new(1.5, 1.5, dist)
    beam.CFrame      = CFrame.new(mid, toPos)
    beam.Parent      = Workspace
end

-- ── HUD heartbeat ────────────────────────────────────────────
hudConn = RunService.Heartbeat:Connect(function()
    if not selectedTornado then
        setHUD("EF",     "--",      Color3.fromRGB(100,100,100))
        setHUD("WIND",   "--",      Color3.fromRGB(100,100,100))
        setHUD("DIST",   "--",      Color3.fromRGB(100,100,100))
        setHUD("DIR",    "--",      Color3.fromRGB(100,100,100))
        setHUD("PRED",   "--",      Color3.fromRGB(100,100,100))
        setHUD("STATUS", "No tornado", Color3.fromRGB(150,150,150))
        local sc = hudCells["SAVE"]
        if sc then
            sc.Text = "-- Select a tornado --"
            sc.TextColor3 = Color3.fromRGB(120,120,120)
            sc.TextSize = 12
            local p = sc.Parent
            if p and p:IsA("Frame") then p.BackgroundColor3 = Color3.fromRGB(8,18,32) end
        end
        predEndMarker.Position = Vector3.new(0, -9999, 0)
        local old = Workspace:FindFirstChild("_PredBeam")
        if old then old:Destroy() end
        velHistory = {}; lastTorPos = nil
        return
    end

    local root = getTornadoRoot(selectedTornado)
    if not root then return end

    local torPos = root.Position

    -- Velocity tracking
    if lastTorPos then
        local vel = torPos - lastTorPos
        table.insert(velHistory, vel)
        if #velHistory > VEL_SAMPLES then table.remove(velHistory, 1) end
    end
    lastTorPos = torPos

    -- ── Read EF & wind from model values ──
    local windMPH = readNum(selectedTornado,
        "windspeed","wind_speed","wind speed","mph","speed","velocity","ws")
    local efRaw   = readNum(selectedTornado,
        "ef","rating","efrating","ef_rating","category","level","intensity")

    -- Fallback: try to read EF from the name itself e.g. "EF3Tornado"
    if not efRaw then
        local n = selectedTornado.Name
        local ef_from_name = n:match("[Ee][Ff](%d)")
        if ef_from_name then efRaw = tonumber(ef_from_name) end
    end

    -- Fallback: infer EF from wind
    local efStr = efRaw and tostring(math.floor(efRaw)) or windToEF(windMPH)

    -- Wind fallback from EF rating
    if not windMPH and efRaw then
        local efWindMap = {[0]=73,[1]=112,[2]=157,[3]=206,[4]=260,[5]=999}
        windMPH = efWindMap[math.floor(efRaw)] or nil
    end

    -- Display EF
    local efColor = EF_COLORS[efStr] or EF_COLORS["?"]
    setHUD("EF", "EF" .. efStr, efColor)

    -- Display wind
    if windMPH then
        setHUD("WIND", math.floor(windMPH) .. " mph", efColor)
    else
        setHUD("WIND", "~" .. (efStr ~= "?" and tostring(
            ({["0"]=73,["1"]=112,["2"]=157,["3"]=206,["4"]=260,["5"]=318})[efStr] or 0
        ) .. " mph" or "--"), efColor)
    end

    -- Distance & heading from player
    local hrp = getHRP()
    if hrp then
        local dist = (hrp.Position - torPos).Magnitude
        setHUD("DIST", math.floor(dist) .. " st", Color3.fromRGB(0, 220, 255))

        local flat = Vector3.new(torPos.X - hrp.Position.X, 0, torPos.Z - hrp.Position.Z)
        local deg  = math.deg(math.atan2(flat.X, flat.Z)) % 360
        setHUD("DIR", toCompass(deg) .. "  " .. math.floor(deg) .. "°", Color3.fromRGB(0, 220, 255))
    end

    -- ── Path prediction ──────────────────────────────────────
    local avgVel = avgVelocity()
    local predSeconds = 30   -- predict 30 seconds ahead
    local Hz = 60            -- approximate heartbeat rate
    local predOffset = avgVel * (predSeconds * Hz)
    local predPos    = torPos + predOffset

    -- Snap to ground level (Y = ~5)
    predPos = Vector3.new(predPos.X, 5, predPos.Z)

    predEndMarker.Position = predPos
    updatePredLine(torPos, predPos)

    local predDist = math.floor((predPos - torPos).Magnitude)
    local predDir  = avgVel.Magnitude > 0.001
        and toCompass(math.deg(math.atan2(avgVel.X, avgVel.Z)) % 360)
        or  "---"
    setHUD("PRED", predDir .. "  " .. predDist .. " st", Color3.fromRGB(255, 140, 0))

    -- Status
    local statusStr, statusColor
    local distToPlayer = hrp and (hrp.Position - torPos).Magnitude or math.huge
    if distToPlayer < 40 then
        statusStr   = "⚠ DANGER"
        statusColor = Color3.fromRGB(255, 30, 30)
    elseif distToPlayer < 120 then
        statusStr   = "⚡ CLOSE"
        statusColor = Color3.fromRGB(255, 160, 0)
    else
        statusStr   = "✔ CLEAR"
        statusColor = Color3.fromRGB(60, 220, 100)
    end
    setHUD("STATUS", statusStr, statusColor)

    -- ── SAVE verdict ─────────────────────────────────────────
    -- Uses wind MPH + EF rating + distance to decide if you should stay
    --   NOT SAVE = EF3+ (136+ mph) OR very close  → too dangerous
    --   MARGINAL  = EF2 (111–135 mph) OR close     → risky, your call
    --   SAVE      = EF0-1 (<111 mph) AND far enough → safe to stay/chase
    local mph     = windMPH or 0
    local efNum   = tonumber(efStr) or 0
    local saveStr, saveColor, saveBg

    if efNum >= 3 or mph >= 136 then
        -- EF3 / EF4 / EF5 — violent, evacuate
        saveStr   = "✖  NOT SAVE  (EF" .. efStr .. " — " .. math.floor(mph) .. " mph)"
        saveColor = Color3.fromRGB(255, 30, 30)
        saveBg    = Color3.fromRGB(60, 5, 5)
    elseif efNum == 2 or mph >= 111 then
        -- EF2 — significant, marginal
        saveStr   = "⚡  MARGINAL  (EF" .. efStr .. " — " .. math.floor(mph) .. " mph)"
        saveColor = Color3.fromRGB(255, 160, 0)
        saveBg    = Color3.fromRGB(45, 25, 0)
    else
        -- EF0 / EF1 — relatively weak
        saveStr   = "✔  SAVE  (EF" .. efStr .. " — " .. math.floor(mph) .. " mph)"
        saveColor = Color3.fromRGB(60, 220, 100)
        saveBg    = Color3.fromRGB(5, 35, 10)
    end

    -- Also override to NOT SAVE if player is dangerously close regardless of EF
    if distToPlayer < 40 then
        saveStr   = "✖  NOT SAVE  (TOO CLOSE)"
        saveColor = Color3.fromRGB(255, 30, 30)
        saveBg    = Color3.fromRGB(60, 5, 5)
    end

    local saveCell = hudCells["SAVE"]
    if saveCell then
        saveCell.Text       = saveStr
        saveCell.TextColor3 = saveColor
        saveCell.TextSize   = 12
        -- tint the parent frame background
        local parent = saveCell.Parent
        if parent and parent:IsA("Frame") then
            parent.BackgroundColor3 = saveBg
        end
    end
end)

