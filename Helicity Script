-- Compass direction from angle (degrees, 0 = north / +Z)
local function toCompass(deg)
    local dirs = {"N","NE","E","SE","S","SW","W","NW","N"}
    return dirs[math.floor((deg % 360) / 45 + 1.5)]
end

