--  VELOCITY TRACKER  (studs/second)
-- ════════════════════════════════════════════════════════════
local VEL_SAMPLES  = 30
local velBuf       = {}
local velBufIdx    = 0
local velBufCount  = 0
local lastTorPos   = nil

local function pushVel(v, dt)
    velBufIdx = (velBufIdx % VEL_SAMPLES) + 1
    velBuf[velBufIdx] = {v=v, dt=dt}
    if velBufCount < VEL_SAMPLES then velBufCount += 1 end
end

local function getAvgVel()
    if velBufCount < 5 then return Vector3.zero, false end
    local sv=Vector3.zero; local sd=0
    for i=1,velBufCount do sv+=velBuf[i].v; sd+=velBuf[i].dt end
    if sd<=0 then return Vector3.zero, false end
    return sv/sd, true
end

-- ════════════════════════════════════════════════════════════
--  EF/WIND CACHE  (scans only every 2s)
-- ════════════════════════════════════════════════════════════
local cachedWind   = nil
local cachedEFStr  = "?"
local cachedEFNum  = 0
local lastScan     = 0
local SCAN_RATE    = 2

local function doScan()
    local wind =
        deepReadNum(selectedTornado,"windspeed","wind_speed","mph","maxwind","windmph","ws","wind") or
        deepReadNum(selectedTornado,"speed","velocity","maxspeed","topspeed","airspeed") or
        readGlobalStormParam("windspeed","wind_speed","mph","maxwind","wind") or nil

    local efRaw =
        deepReadNum(selectedTornado,"ef","efrating","ef_rating","efscale","rating","category","tier","level","intensity","rank","strength") or
        readGlobalStormParam("ef","efrating","ef_rating","efscale","rating","category") or nil

    if not efRaw then
        local m=selectedTornado.Name:match("[Ee][Ff](%d)"); if m then efRaw=tonumber(m) end
    end

    local efStr = efRaw and tostring(math.clamp(math.floor(efRaw),0,5)) or windToEF(wind)
    local efNum = tonumber(efStr) or 0
    if not wind then
        local EFW={[0]=73,[1]=112,[2]=157,[3]=206,[4]=260,[5]=318}
        wind=EFW[efNum]
    end
    cachedWind=wind; cachedEFStr=efStr; cachedEFNum=efNum
end

-- ════════════════════════════════════════════════════════════
--  HUD LOOPS
-- ════════════════════════════════════════════════════════════
-- Loop A: velocity only (every frame, very cheap)
RunService.Heartbeat:Connect(function(dt)
    if not selectedTornado then return end
    local root=getTornadoRoot(selectedTornado); if not root then return end
    if lastTorPos and dt>0 then pushVel((root.Position-lastTorPos)/dt,dt) end
    lastTorPos=root.Position
end)

-- Loop B: UI updates (throttled — max 10/sec, only writes on change)
local lastUIUpdate=0
RunService.Heartbeat:Connect(function()
    if not selectedTornado then
        if _hudCache.active then
            _hudCache={}; clearHUD()
            predMarker.Position=Vector3.new(0,-9999,0); hideBeam()
            velBuf={}; velBufIdx=0; velBufCount=0; lastTorPos=nil
            cachedWind=nil; cachedEFStr="?"; cachedEFNum=0; lastScan=0
        end
        return
    end
    _hudCache.active=true

    local now=tick()
    if (now-lastUIUpdate)<0.1 then return end
    lastUIUpdate=now

    local root=getTornadoRoot(selectedTornado); if not root then return end
    local torPos=root.Position

    -- EF/wind scan (throttled)
    if (now-lastScan)>=SCAN_RATE then lastScan=now; doScan() end

    local wind=cachedWind; local efStr=cachedEFStr or "?"; local efNum=cachedEFNum or 0
    local efCol=EF_COL[efStr] or EF_COL["?"]
    setHUD("EF","EF"..efStr,efCol,Color3.fromRGB(8,18,32))
    setHUD("WIND",wind and (math.floor(wind).." mph") or "--",efCol,Color3.fromRGB(8,18,32))

    -- Distance & heading
    local hrp=getHRP(); local dist=math.huge
    if hrp then
        dist=(hrp.Position-torPos).Magnitude
        setHUD("DIST",math.floor(dist).." st",Color3.fromRGB(0,220,255),Color3.fromRGB(8,18,32))
        local flat=Vector3.new(torPos.X-hrp.Position.X,0,torPos.Z-hrp.Position.Z)
        local deg=math.deg(math.atan2(flat.X,flat.Z))%360
        setHUD("DIR",toCompass(deg).."  "..math.floor(deg).."°",Color3.fromRGB(0,220,255),Color3.fromRGB(8,18,32))
    end

    -- Prediction
    local av,hasData=getAvgVel()
    if hasData and av.Magnitude>0.05 then
        local pp=Vector3.new(torPos.X+av.X*45,5,torPos.Z+av.Z*45)
        predMarker.Position=pp; updateBeam(torPos,pp)
        local pdist=math.floor((pp-torPos).Magnitude)
        local pdir=toCompass(math.deg(math.atan2(av.X,av.Z))%360)
        setHUD("PRED",pdir.."  "..pdist.."st  ("..math.floor(av.Magnitude).."st/s)",Color3.fromRGB(255,140,0),Color3.fromRGB(8,18,32))
    else
        predMarker.Position=Vector3.new(0,-9999,0); hideBeam()
        setHUD("PRED","Tracking...",Color3.fromRGB(150,150,150),Color3.fromRGB(8,18,32))
    end

    -- Status
    local ss,sc
    if dist<40 then ss="⚠ DANGER"; sc=Color3.fromRGB(255,30,30)
    elseif dist<120 then ss="⚡ CLOSE"; sc=Color3.fromRGB(255,160,0)
    else ss="✔ CLEAR"; sc=Color3.fromRGB(60,220,100) end
    setHUD("STATUS",ss,sc,Color3.fromRGB(8,18,32))

    -- SAVE verdict
    local mph=wind or 0; local svStr,svCol,svBg
    if dist<40 then
        svStr="✖  NOT SAVE  —  TOO CLOSE"; svCol=Color3.fromRGB(255,50,50); svBg=Color3.fromRGB(55,5,5)
    elseif efNum>=3 or mph>=136 then
        svStr="✖  NOT SAVE  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        svCol=Color3.fromRGB(255,50,50); svBg=Color3.fromRGB(55,5,5)
    elseif efNum==2 or mph>=111 then
        svStr="⚡  MARGINAL  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        svCol=Color3.fromRGB(255,165,0); svBg=Color3.fromRGB(45,22,0)
    else
        svStr="✔  SAVE  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        svCol=Color3.fromRGB(60,220,100); svBg=Color3.fromRGB(5,35,10)
    end
    local sv=hudCells["SAVE"]
    if sv.val.Text~=svStr then sv.val.Text=svStr end
    if sv.val.TextColor3~=svCol then sv.val.TextColor3=svCol end
    sv.val.TextSize=11
    if sv.cell.BackgroundColor3~=svBg then sv.cell.BackgroundColor3=svBg end
end)

