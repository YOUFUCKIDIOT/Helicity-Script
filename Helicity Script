-- Broader detection: also checks for storm script folders & tagged models
-- Words that must NOT appear anywhere in the name for it to count as a tornado
local TORNADO_BLACKLIST = {
    "warning","alert","siren","alarm","sign","label","gui","ui","hud",
    "door","gate","wall","fence","floor","ceiling","roof","window","frame",
    "button","text","image","icon","screen","billboard","decal","surface",
    "spawn","zone","region","area","trigger","sensor","detector","hitbox","hitpart",
    "sound","music","audio","effect","particle","smoke","fire","spark",
    "shadow","light","lamp","beam","ray",
    "script","module","value","folder","tool","handle",
    "debris","wreckage","damage","destruction",
}

-- Words that MUST appear for it to be a real tornado model
-- (name must match one of these standalone patterns)
local TORNADO_WHITELIST_PATTERNS = {
    "^ef%d",           -- starts with EF0-EF9
    "^tornado$",       -- exactly "tornado"
    "tornado%s*%d",    -- tornado + number e.g. "Tornado 1"
    "%d%s*tornado",    -- number + tornado e.g. "1 Tornado"
    "ef%d.*tornado",   -- EF + tornado combo
    "tornado.*ef%d",   -- tornado + EF combo
    "^vortex$",
    "vortex%s*%d",
    "^wedge$",
    "wedge.*ef",
    "ef.*wedge",
    "^cyclone$",
    "^twister$",
    "^funnel$",
    "^mesocyclone$",
    "stovepipe",
    "rope.*tornado",
    "wedge.*tornado",
    "cone.*tornado",
}

local function isTornadoModel(obj)
    local n = obj.Name:lower()

    -- Must be a Model with at least one BasePart (not empty/UI containers)
    local hasPart = false
    for _,v in ipairs(obj:GetChildren()) do
        if v:IsA("BasePart") or v:IsA("Model") then hasPart=true; break end
    end
    if not hasPart then return false end

    -- Reject anything matching the blacklist
    for _,bad in ipairs(TORNADO_BLACKLIST) do
        if n:find(bad,1,true) then return false end
    end

    -- Must match at least one whitelist pattern
    for _,pat in ipairs(TORNADO_WHITELIST_PATTERNS) do
        if n:match(pat) then return true end
    end

    return false
end

local function getTornadoes()
    local found = {}
    local seen  = {}
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and not seen[obj] and isTornadoModel(obj) then
            -- Only add top-level — skip if already a child of a found tornado
            local skip=false
            for _,f in ipairs(found) do
                if obj:IsDescendantOf(f) then skip=true; break end
            end
            if not skip then
                seen[obj]=true
                table.insert(found,obj)
            end
        end
    end
    return found
end

local function getTornadoRoot(t)
    if not t then return nil end
    local pp = t.PrimaryPart
    if pp then return pp end
    -- Find the lowest (ground-level) BasePart as root
    local best, bestY = nil, math.huge
    for _,p in ipairs(t:GetDescendants()) do
        if p:IsA("BasePart") and p.Position.Y < bestY then
            best=p; bestY=p.Position.Y
        end
    end
    return best
end

local function buildTornadoNames()
    tornadoList = getTornadoes()
    local names = {"-- None --"}
    for i,t in ipairs(tornadoList) do
        names[i+1] = t.Name.." ["..i.."]"
    end
    return names
end

