local FreecamTab = Window:CreateTab("Freecam ⚠", 4483362458)
FreecamTab:CreateSection("⚠ Currently bugged — WIP")
FreecamTab:CreateLabel("J to toggle  •  WASD  •  Space/Shift  •  Mouse look")

local function enableFreecam()
    local c=getChar()
    if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end end end
    freecamPart=Instance.new("Part")
    freecamPart.Anchored=true; freecamPart.CanCollide=false; freecamPart.Transparency=1
    freecamPart.Size=Vector3.new(1,1,1); freecamPart.CFrame=camera.CFrame; freecamPart.Parent=Workspace
    camera.CameraType=Enum.CameraType.Scriptable; camera.CameraSubject=nil
    freecamConns[#freecamConns+1]=RunService.RenderStepped:Connect(function(dt)
        if not freecamEnabled then return end
        local spd=freecamSpeed*60*dt; local cf=camera.CFrame; local mv=Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W)         then mv+=cf.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)         then mv-=cf.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)         then mv-=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)         then mv+=cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)     then mv+=Vector3.yAxis  end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv-=Vector3.yAxis  end
        if mv.Magnitude>0 then freecamPart.CFrame=freecamPart.CFrame+mv.Unit*spd end
        camera.CFrame=CFrame.new(freecamPart.Position,freecamPart.Position+cf.LookVector)
    end)
    freecamConns[#freecamConns+1]=UserInputService.InputChanged:Connect(function(input)
        if not freecamEnabled then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement then
            local dx,dy=input.Delta.X*0.004,input.Delta.Y*0.004
            local cf=camera.CFrame
            camera.CFrame=CFrame.new(cf.Position)*CFrame.Angles(0,-dx,0)*CFrame.Angles(-dy,0,0)
            freecamPart.CFrame=camera.CFrame
        end
    end)
end

local function disableFreecam()
    for _,c in ipairs(freecamConns) do pcall(function() c:Disconnect() end) end
    freecamConns={}
    if freecamPart then freecamPart:Destroy(); freecamPart=nil end
    camera.CameraType=Enum.CameraType.Custom; camera.CameraSubject=getHum()
    local c=getChar()
    if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end end end
end

FreecamTab:CreateToggle({
    Name="Enable Freecam  [J]", CurrentValue=false, Flag="Freecam",
    Callback=function(val) freecamEnabled=val; if val then enableFreecam() else disableFreecam() end end,
})
FreecamTab:CreateSlider({
    Name="Freecam Speed", Range={1,30}, Increment=1, Suffix="x",
    CurrentValue=1, Flag="FreecamSpd",
    Callback=function(val) freecamSpeed=val end,
})
UserInputService.InputBegan:Connect(function(input,gpe)
    if gpe then return end
    if input.KeyCode==Enum.KeyCode.J then
        freecamEnabled=not freecamEnabled
        if freecamEnabled then enableFreecam() else disableFreecam() end
    end
end)

