-- ════════════════════════════════════════════════════════════
--  VELOCITY TRACKER  (fixed — tracks studs/second properly)
-- ════════════════════════════════════════════════════════════
local SAMPLES       = 30   -- keep last 30 samples (~0.5 sec)
local velSamples    = {}   -- {vel: Vector3, dt: number}
local lastTorPos    = nil
local lastTorTime   = nil

local function pushSample(vel, dt)
    table.insert(velSamples, {vel=vel, dt=dt})
    if #velSamples > SAMPLES then table.remove(velSamples, 1) end
end

-- Returns average velocity in STUDS PER SECOND
local function getAvgVelocity()
    if #velSamples < 3 then return Vector3.zero, false end
    local sumVel = Vector3.zero
    local totalDt = 0
    for _, s in ipairs(velSamples) do
        sumVel  += s.vel
        totalDt += s.dt
    end
    if totalDt <= 0 then return Vector3.zero, false end
    return sumVel / totalDt, true  -- studs per second
end

-- ════════════════════════════════════════════════════════════
--  HUD HEARTBEAT  (fixed EF/wind + fixed prediction)
-- ════════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function(dt)
    if not selectedTornado then
        clearHUD()
        predMarker.Position=Vector3.new(0,-9999,0)
        local b=Workspace:FindFirstChild("_HubBeam"); if b then b:Destroy() end
        velSamples={}; lastTorPos=nil; lastTorTime=nil
        return
    end

    local root=getTornadoRoot(selectedTornado)
    if not root then return end
    local torPos=root.Position

    -- Velocity tracking (studs per second)
    if lastTorPos and dt > 0 then
        local frameDelta = torPos - lastTorPos
        pushSample(frameDelta / dt, dt)  -- convert to per-second
    end
    lastTorPos = torPos

    -- ── Read wind speed (very broad search) ──────────────────
    -- Try tornado model first, then global workspace storm data
    local windMPH =
        deepReadNum(selectedTornado, "windspeed","wind_speed","wind speed","mph","maxwind","windmph","ws") or
        deepReadNum(selectedTornado, "speed","velocity","maxspeed","topspeed") or
        readGlobalStormParam("windspeed","wind_speed","wind speed","mph","maxwind") or
        nil

    -- ── Read EF rating ────────────────────────────────────────
    local efRaw =
        deepReadNum(selectedTornado, "ef","efrating","ef_rating","efscale","rating","category","tier","level","intensity","rank") or
        readGlobalStormParam("ef","efrating","ef_rating","efscale","rating") or
        nil

    -- Fallback: parse EF from tornado name  e.g. "EF3Tornado", "ef2_wedge"
    if not efRaw then
        local m = selectedTornado.Name:match("[Ee][Ff](%d)")
        if m then efRaw = tonumber(m) end
    end

    -- Fallback: infer EF from wind if we have wind
    local efStr = efRaw and tostring(math.clamp(math.floor(efRaw), 0, 5)) or windToEF(windMPH)
    local efNum = tonumber(efStr) or 0

    -- Fallback: estimate wind from EF if still no wind
    if not windMPH then
        local EF_WIND = {[0]=73,[1]=112,[2]=157,[3]=206,[4]=260,[5]=318}
        windMPH = EF_WIND[efNum]
    end

    local efColor = EF_COL[efStr] or EF_COL["?"]
    setHUD("EF",   "EF"..efStr,                              efColor, Color3.fromRGB(8,18,32))
    setHUD("WIND", windMPH and (math.floor(windMPH).." mph") or "--", efColor, Color3.fromRGB(8,18,32))

    -- ── Distance & heading ────────────────────────────────────
    local hrp=getHRP()
    local distToPlayer=math.huge
    if hrp then
        distToPlayer=(hrp.Position-torPos).Magnitude
        setHUD("DIST", math.floor(distToPlayer).." st", Color3.fromRGB(0,220,255), Color3.fromRGB(8,18,32))
        local flat=Vector3.new(torPos.X-hrp.Position.X,0,torPos.Z-hrp.Position.Z)
        local deg=math.deg(math.atan2(flat.X,flat.Z))%360
        setHUD("DIR", toCompass(deg).."  "..math.floor(deg).."°", Color3.fromRGB(0,220,255), Color3.fromRGB(8,18,32))
    end

    -- ── Path prediction (fixed) ───────────────────────────────
    -- avgVelocity is now in STUDS PER SECOND
    -- Predict 45 seconds ahead
    local avgVelocity, hasData = getAvgVelocity()

    if hasData and avgVelocity.Magnitude > 0.05 then
        local PRED_SECONDS = 45
        local predOffset   = avgVelocity * PRED_SECONDS
        local predPos      = Vector3.new(torPos.X + predOffset.X, 5, torPos.Z + predOffset.Z)

        predMarker.Position = predPos
        updateBeam(torPos, predPos)

        local predDist = math.floor((predPos - torPos).Magnitude)
        local predDir  = toCompass(math.deg(math.atan2(avgVelocity.X, avgVelocity.Z)) % 360)
        local speedSt  = math.floor(avgVelocity.Magnitude)

        setHUD("PRED",
            predDir.."  "..predDist.." st  ("..speedSt.." st/s)",
            Color3.fromRGB(255,140,0), Color3.fromRGB(8,18,32))
    else
        -- Not enough data yet
        predMarker.Position = Vector3.new(0,-9999,0)
        local b=Workspace:FindFirstChild("_HubBeam"); if b then b:Destroy() end
        setHUD("PRED", "Tracking...", Color3.fromRGB(150,150,150), Color3.fromRGB(8,18,32))
    end

    -- ── Status ────────────────────────────────────────────────
    local statStr, statCol
    if distToPlayer < 40 then
        statStr="⚠ DANGER"; statCol=Color3.fromRGB(255,30,30)
    elseif distToPlayer < 120 then
        statStr="⚡ CLOSE";  statCol=Color3.fromRGB(255,160,0)
    else
        statStr="✔ CLEAR";   statCol=Color3.fromRGB(60,220,100)
    end
    setHUD("STATUS", statStr, statCol, Color3.fromRGB(8,18,32))

    -- ── SAVE verdict ──────────────────────────────────────────
    local mph=windMPH or 0
    local saveStr, saveCol, saveBg
    if distToPlayer < 40 then
        saveStr="✖  NOT SAVE  —  TOO CLOSE"
        saveCol=Color3.fromRGB(255,50,50); saveBg=Color3.fromRGB(55,5,5)
    elseif efNum >= 3 or mph >= 136 then
        saveStr="✖  NOT SAVE  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        saveCol=Color3.fromRGB(255,50,50); saveBg=Color3.fromRGB(55,5,5)
    elseif efNum == 2 or mph >= 111 then
        saveStr="⚡  MARGINAL  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        saveCol=Color3.fromRGB(255,165,0); saveBg=Color3.fromRGB(45,22,0)
    else
        saveStr="✔  SAVE  —  EF"..efStr.."  ("..math.floor(mph).." mph)"
        saveCol=Color3.fromRGB(60,220,100); saveBg=Color3.fromRGB(5,35,10)
    end
    local sv=hudCells["SAVE"]
    sv.val.Text=saveStr; sv.val.TextColor3=saveCol; sv.val.TextSize=12
    sv.cell.BackgroundColor3=saveBg
end)

